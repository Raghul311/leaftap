{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": false
  },
  "include": [
    "tests/**/*.ts",
    "page/**/*.ts",
    "utils/**/*.ts",
    "scripts/**/*.ts"
  ]
}
